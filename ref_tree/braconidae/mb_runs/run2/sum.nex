#NEXUS

begin mrbayes;
    set autoclose=yes nowarn=yes;

    set dir="../";
    exe braconidae.nex;
    exe braconidae_constraints.nex;
    set dir="";

    charset 1st = 1-. \3;
    charset 2nd = 2-. \3;
    charset 3rd = 3-. \3;
    partition cod = 3: 1st, 2nd, 3rd;
    set partition=cod;
 
    prset brlenspr=clock:uniform clockvarpr=strict;
    prset topologypr=constraints(1-67);

    lset rates=gamma nst=mixed;
    prset ratepr=variable;
    unlink shape=(all) statefreq=(all) revmat=(all);

    mcmcp nruns=16 nchains=4 diagnfreq=10000 printfreq=2000 samplefreq=5000 ngen=100000000;
    sumt;
    sump;
end;

